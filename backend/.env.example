# ============================================================
# Backend .env — used by start-services.sh (local without Docker)
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================================

# --- Server ---
PORT=8080
ENV=development

# --- Turso Database ---
# Get credentials from: https://turso.tech/
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# --- Clerk Authentication ---
# Get credentials from: https://clerk.com
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- JWT ---
JWT_SECRET=your-secret-key-change-in-production

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# --- Redis / Upstash (optional, for future use) ---
# Local dev:
# REDIS_URL=redis://localhost:6379
# Production (Upstash):
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Feature Flags ---
# Set to "true" to start a service via start-services.sh.
# Disabled services are skipped and the gateway hides their routes.
FEATURE_DSA_ENABLED=false
FEATURE_CERTIFICATIONS_ENABLED=false
FEATURE_SYSTEM_DESIGN_ENABLED=true
FEATURE_AI_SYSTEM_DESIGN_ENABLED=true
FEATURE_GAMIFICATION_ENABLED=true
