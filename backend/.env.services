# Environment variables for microservices
# Copy this file to .env and fill in your values

# Database Configuration (Turso)
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=your-auth-token-here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Service Ports (for local development without Docker)
GATEWAY_PORT=8080
AUTH_PORT=8081
DSA_PORT=8082
SYSTEM_DESIGN_PORT=8083
AI_SYSTEM_DESIGN_PORT=8084
CERTIFICATIONS_PORT=8085
GAMIFICATION_PORT=8086

# Service URLs (for local development without Docker)
AUTH_SERVICE_URL=http://localhost:8081
DSA_SERVICE_URL=http://localhost:8082
SYSTEM_DESIGN_SERVICE_URL=http://localhost:8083
AI_SYSTEM_DESIGN_SERVICE_URL=http://localhost:8084
CERTIFICATIONS_SERVICE_URL=http://localhost:8085
GAMIFICATION_SERVICE_URL=http://localhost:8086
