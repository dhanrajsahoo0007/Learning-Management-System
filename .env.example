# ============================================================
# Root .env — used by docker-compose.yml (local development)
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================================

# --- Turso / SQLite ---
# Local SQLite (default for dev):
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# Remote Turso (uncomment and fill for cloud dev DB):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-auth-token

# --- Clerk (dev instance) ---
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# --- JWT ---
JWT_SECRET=local-dev-secret-change-in-production

# --- Redis (local container, no auth) ---
REDIS_URL=redis://redis:6379

# --- Feature Flags ---
# Set to "true" to enable a module. Disabled modules do not start as containers
# and the gateway does not register their proxy routes.
# Re-enable DSA/Certifications with:
#   FEATURE_DSA_ENABLED=true
#   FEATURE_CERTIFICATIONS_ENABLED=true
#   docker compose --profile full up --build
FEATURE_DSA_ENABLED=false
FEATURE_CERTIFICATIONS_ENABLED=false
FEATURE_SYSTEM_DESIGN_ENABLED=true
FEATURE_AI_SYSTEM_DESIGN_ENABLED=true
FEATURE_GAMIFICATION_ENABLED=true

# Service URLs used only when the matching feature is enabled
# DSA_SERVICE_URL=http://dsa:8082
# CERTIFICATIONS_SERVICE_URL=http://certifications:8085
